    },
    {
      "id": "test",
      "name": "Test the billing rule",
      "tools": [
        "Approvals"
      ],
      "rule": "Observe mode bills, so the rule is read before anything is tried.",
      "rule_ref": "https://code.claude.com/docs/en/claude-ship",
      "metric": "cp_kept_off.per_use_spend"
    },
    {
      "id": "decide",
      "name": "Billing card or stay off",
      "tools": [
        "PR Steward"
      ],
      "rule": "A feature stays off unless a billing card is approved.",
      "rule_ref": "https://code.claude.com/docs/en/claude-ship",
      "metric": "cp_kept_off.per_use_spend"
    }
  ]
