{
  "_README": [
    "Claudius's AI merge policy for tools/merge_policy.py (Git Crafter templates/open/merge_policy.json,",
    "skills/merging/outside.md). An outside PR may change only the ideal states' text with no maintainer:",
    "ideals/*.json, read by the page and never run. Targets define the gates, collectors and quality/ run in",
    "CI, and maps choose what each Process step reads, so each of those waits for a maintainer.",
    "Default deny: a path on neither list is not AI-mergeable. maintainer_only wins",
    "over ai_mergeable. Every path that runs at build or install time, defines a",
    "gate, or states the rules belongs in maintainer_only.",
    "samples: each group is a list of PR path lists; --self-test checks them, and",
    "a policy with an empty group fails it."
  ],
  "maintainer_only": [
    ".github/**",
    ".githooks/**",
    ".husky/**",
    ".claude/**",
    ".devcontainer/**",
    "tools/**",
    "scripts/**",
    "**/migrations/**",
    "**/package.json",
    "**/package-lock.json",
    "**/npm-shrinkwrap.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/pyproject.toml",
    "**/uv.lock",
    "**/requirements*.txt",
    "**/Pipfile*",
    "**/Dockerfile*",
    "**/*.config.js",
    "**/*.config.cjs",
    "**/*.config.mjs",
    "**/*.config.ts",
    "**/wrangler.toml",
    "**/wrangler.json",
    "**/wrangler.jsonc",
    "**/.npmrc",
    "**/.nvmrc",
    "**/.gitignore",
    "**/.gitattributes",
    "**/.env*",
    "merge_policy.json",
    "LICENSE",
    "NOTICE",
    "CODEOWNERS",
    "**/AGENTS.md",
    "**/CLAUDE.md",
    "GOVERNANCE.md",
    "MAINTAINERS.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "**/_worker.js",
    "**/_headers",
    "**/_redirects",
    "tests/**",
    "**/*.test.*",
    "**/conftest.py",
    "**/*.svg",
    "**/.claude/**",
    "pack.json",
    "targets/**",
    "collectors/**",
    "quality/**",
    "fixtures/**",
    "maps/**",
    "CODE_OF_CONDUCT.md"
  ],
  "ai_mergeable": [
    "ideals/*.json"
  ],
  "samples": {
    "ai_mergeable": [
      [
        "ideals/claude.json"
      ],
      [
        "ideals/blockers.json",
        "ideals/tokens.json"
      ]
    ],
    "maintainer_only": [
      [
        ".github/workflows/ci.yml"
      ],
      [
        "src/package.json"
      ],
      [
        "src/app/vite.config.ts"
      ],
      [
        "docs/guide.md",
        "package-lock.json"
      ],
      [
        "CLAUDE.md"
      ],
      [
        "tests/pages.test.mjs"
      ],
      [
        "public/_worker.js"
      ],
      [
        "src/content/x.test.md"
      ],
      [
        "public/images/logo.svg"
      ],
      [
        "docs/team/CLAUDE.md"
      ],
      [
        "content/x/.claude/settings.json"
      ],
      [
        "targets/claude.json"
      ],
      [
        "collectors/claude/claude.mjs"
      ],
      [
        "ideals/claude.json",
        "pack.json"
      ],
      [
        "maps/guard.json"
      ],
      [
        "quality/public.mjs"
      ]
    ],
    "default_deny": [
      [
        "README.md"
      ],
      [
        "vendor/lib.js"
      ],
      [
        "docs/guide.md"
      ],
      [
        "ideals/notes.md"
      ]
    ],
    "refused": [
      [
        "src/../.github/workflows/ci.yml"
      ],
      [
        "/etc/hosts"
      ],
      [
        "src//pages/x.md"
      ],
      [
        "src\\pages\\x.md"
      ]
    ]
  }
}
